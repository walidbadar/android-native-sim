config BOARD_NATIVE_SIM
	select 64BIT if BOARD_NATIVE_SIM_NATIVE_AARCH64

config ANDROID_PHONE_IP
	string "IP address of the Android phone"
	depends on BOARD_NATIVE_SIM_NATIVE_AARCH64
	help
	  Where "west build -t run" finds the phone. When it is empty, adb uses the
	  phone it already sees, and an application with a screen asks adb for the
	  address to reach Termux over SSH. When it is set, adb connects to it.
